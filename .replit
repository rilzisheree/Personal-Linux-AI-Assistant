modules = ["nodejs-20", "python-3.12", "web"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Lura API"

[[workflows.workflow]]
name = "Lura API"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd local-ai-assistant && python3 -m local_ai_assistant.api"
waitForPort = 8000

[workflows.workflow.metadata]
outputType = "console"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["dbus", "ffmpeg", "ffmpeg-full", "fontconfig", "libglvnd", "libxcrypt", "libxkbcommon", "zstd"]

[[ports]]
localPort = 8000
externalPort = 80

[userenv]

[userenv.shared]
LURA_AI_PROVIDER = "gemini"
LURA_GEMINI_MODEL = "gemini-3.6-flash"
